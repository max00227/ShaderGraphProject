    "m_SourceType": 1,
    "m_FunctionName": "TileableVoronoi",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 g = floor(UV * CellDensity);\r\nfloat2 f = frac(UV * CellDensity);\r\nfloat3 res = float3(8.0, 0.0, 0.0);\r\n\r\nfor (int y = -1; y <= 1; y++) {\r\n    for (int x = -1; x <= 1; x++) {\r\n        float2 lattice = float2(x, y);\r\n        float2 cell = g + lattice;\r\n\r\n        // 核心邏輯：控制X軸（左右）與Y軸（上下）的無縫拼接 (直接展開 safe_mod 避免報錯)\r\n        if (Period.x > 0.0) cell.x = fmod(fmod(cell.x, Period.x) + Period.x, Period.x);\r\n        if (Period.y > 0.0) cell.y = fmod(fmod(cell.y, Period.y) + Period.y, Period.y);\r\n\r\n        // 隨機向量生成 (直接展開避免報錯)\r\n        float2x2 m = float2x2(15.27, 47.63, 99.41, 89.98);\r\n        float2 randomUV = frac(sin(mul(cell, m)) * 46839.32);\r\n        float2 offset = float2(sin(randomUV.y * AngleOffset) * 0.5 + 0.5, cos(randomUV.x * AngleOffset) * 0.5 + 0.5);\r\n\r\n        float d = distance(lattice + offset, f);\r\n\r\n        if (d < res.x) {\r\n            res = float3(d, offset.x, offset.y);\r\n            Out = res.x;\r\n            Cells = res.y;\r\n        }\r\n    }\r\n}"
}

