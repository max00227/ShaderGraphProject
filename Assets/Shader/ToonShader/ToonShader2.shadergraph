{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "2dd73a5ebd03462db2934f0a03be0bae",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetAdditionalLights (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 758.9999389648438,
            "y": 771.9998779296875,
            "width": 265.99993896484377,
            "height": 125.0001220703125
        }
    },
    "m_Slots": [
        {
            "m_Id": "004e46bbd6e347bb87391e11416f3076"
        },
        {
            "m_Id": "9e7c2c31beb84abead4f132e2b9f6612"
        },
        {
            "m_Id": "e791028fd3884482aed650670a0ff4e6"
        },
        {
            "m_Id": "7e491b41ff404d8a8d1a171da6ae80a3"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetAdditionalLights",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(SHADERGRAPH_PREVIEW)\r\n    AdditionalColor = float3(0, 0, 0);\r\n#else\r\n    float3 finalColor = float3(0, 0, 0);\r\n    \r\n    #if defined(UNIVERSAL_LIGHTING_INCLUDED)\r\n        uint lightCount = GetAdditionalLightsCount();\r\n        \r\n        for (uint i = 0u; i < lightCount; ++i)\r\n        {\r\n            // 抓取第 i 盞額外光源\r\n            Light light = GetAdditionalLight(i, WorldPosition);\r\n            \r\n            // 計算光線與法線的角度 (N dot L)\r\n            float NdotL = saturate(dot(WorldNormal, light.direction));\r\n            \r\n            // 🌟 核心加回：卡通硬邊遮罩 (大於閾值變 1，小於變 0)\r\n            float toonMask = step(ToonThreshold, NdotL);\r\n            \r\n            // 距離與陰影衰減 (讓光有照射範圍限制)\r\n            float attenuation = light.distanceAttenuation * light.shadowAttenuation;\r\n            \r\n            // 疊加顏色：燈色 × 硬邊遮罩 × 範圍衰減\r\n            finalColor += light.color * toonMask * attenuation;\r\n        }\r\n    #endif\r\n\r\n    AdditionalColor = finalColor;\r\n#endif"
}

