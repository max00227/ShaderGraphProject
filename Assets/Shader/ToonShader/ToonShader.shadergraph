    "m_FunctionBody": "#if defined(SHADERGRAPH_PREVIEW)\r\n    AdditionalColor = float3(0, 0, 0);\r\n#else\r\n    float3 finalColor = float3(0, 0, 0);\r\n    \r\n    #if defined(UNIVERSAL_LIGHTING_INCLUDED)\r\n        uint lightCount = GetAdditionalLightsCount();\r\n        \r\n        for (uint i = 0u; i < lightCount; ++i)\r\n        {\r\n            Light light = GetAdditionalLight(i, WorldPosition);\r\n            \r\n            // 1. 將 角度、距離衰減、陰影 全部相乘，得到該像素接收到的「總物理光照強度」\r\n            float NdotL = saturate(dot(WorldNormal, light.direction));\r\n            float physicalIntensity = NdotL * light.distanceAttenuation * light.shadowAttenuation;\r\n            \r\n            // 2. 統一把總強度送進 step，切出完美的二次元硬邊！\r\n            // 💡 建議在 Shader Graph 面板將 ToonThreshold 設為 0.05 左右\r\n            float toonMask = step(ToonThreshold, physicalIntensity);\r\n            \r\n            // 3. 疊加點光源顏色\r\n            finalColor += light.color * toonMask;\r\n        }\r\n    #endif\r\n\r\n    AdditionalColor = finalColor;\r\n#endif"
}

