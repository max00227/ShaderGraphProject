{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c3fe171adfe7426e9e9d99fed4350357",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Dither (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3387.000244140625,
            "y": -172.00003051757813,
            "width": 208.0,
            "height": 326.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "77fc5161a9b54c75a9b8d6aca7ad6d34"
        },
        {
            "m_Id": "a06d0dc54e604f7cb313b148219c4cd7"
        },
        {
            "m_Id": "f709b87aeb6b43799321b61a7f496677"
        },
        {
            "m_Id": "e02bfe3bb5824458ae3e50dfb488600e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Dither",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 定義 4x4 Bayer Matrix\r\nconst float4x4 bayer = float4x4(\r\n    0,  8,  2, 10,\r\n    12, 4, 14,  6,\r\n    3, 11,  1,  9,\r\n    15, 7, 13,  5\r\n) / 16.0;\r\n\r\n// 計算當前像素在 4x4 矩陣中的位置\r\n// 我們乘上 Resolution 是為了確保 Pattern 對齊螢幕像素\r\nint x = int(fmod(ScreenPos.x * _ScreenParams.x, 4.0));\r\nint y = int(fmod(ScreenPos.y * _ScreenParams.y, 4.0));\r\n\r\n// 取得矩陣中的閥值\r\nfloat threshold = bayer[x][y] - 0.5;\r\n\r\n// 將顏色轉為亮度 (Luminance)\r\nfloat luma = dot(Color, float3(0.299, 0.587, 0.114));\r\n\r\n// 核心邏輯：如果亮度 + 抖動值 < 0.5 則變暗，否則變亮\r\n// 這裡我們只對陰影部分做加強\r\nfloat ditherValue = threshold * Intensity;\r\n\r\n// 簡單的應用方式：直接加到顏色上，然後做 Step 或 Posterize\r\nOut = Color + ditherValue;"
}

