{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "14bedb4117164f5caa764c8ccf399c7f",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "PixelateUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3926.999755859375,
            "y": -463.9999694824219,
            "width": 216.0,
            "height": 326.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "88f642cd6cc04838bcc645c5c54dd8d7"
        },
        {
            "m_Id": "5d599edce2784dbfb0fc59a2ce45b11c"
        },
        {
            "m_Id": "d4275b38b48b4906953717fb0080435a"
        },
        {
            "m_Id": "a141aab2132c4f0ab3183b33707bb211"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PixelateUV",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 計算網格座標\r\nfloat2 grid = InUV * Resolution;\r\n\r\n// 取得小數部分 (0~1 在每個像素格內)\r\nfloat2 alpha = frac(grid);\r\n\r\n// 計算網格中心點\r\nfloat2 center = floor(grid) + 0.5;\r\n\r\n// 核心邏輯：計算偏移量\r\n// 當 Smoothness 很小時，除法結果很大，clamp 會瞬間鎖死在 -0.5 或 0.5 (硬邊)\r\n// 當 Smoothness 很大時，過渡會變平緩 (軟邊)\r\nfloat2 offset = clamp((alpha - 0.5) / max(Smoothness, 0.0001), -0.5, 0.5);\r\n\r\n// 輸出修正後的 UV\r\nOut = (center + offset) / Resolution;"
}

